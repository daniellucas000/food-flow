// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  STAFF
}

enum DeliveryType {
  DELIVERY
  PICKUP
}

enum OrderStatus {
  RECEIVED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  ONLINE
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Store {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  phone            String
  whatsappNumber   String?
  logoUrl          String?
  bannerUrl        String?
  street           String
  number           String
  neighborhood     String
  city             String
  state            String
  zipCode          String
  lat              Float?
  lng              Float?
  deliveryFee      Decimal  @default(0) @db.Decimal(10, 2)
  deliveryRadiusKm Float?
  openingHours     Json
  isOpen           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users      User[]
  categories Category[]
  menuItems  MenuItem[]
  customers  Customer[]
  orders     Order[]
}

model User {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(STAFF)
  createdAt DateTime @default(now())
}

model Category {
  id        String     @id @default(uuid())
  storeId   String
  store     Store      @relation(fields: [storeId], references: [id])
  name      String
  position  Int        @default(0)
  isActive  Boolean    @default(true)
  menuItems MenuItem[]
}

model MenuItem {
  id          String   @id @default(uuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?
  isAvailable Boolean  @default(true)
  position    Int      @default(0)

  optionGroups ItemOptionGroup[]
  orderItems   OrderItem[]
}

model ItemOptionGroup {
  id         String   @id @default(uuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  name       String
  minSelect  Int      @default(0)
  maxSelect  Int      @default(1)
  required   Boolean  @default(false)

  options ItemOption[]
}

model ItemOption {
  id            String          @id @default(uuid())
  groupId       String
  group         ItemOptionGroup @relation(fields: [groupId], references: [id])
  name          String
  priceModifier Decimal         @default(0) @db.Decimal(10, 2)

  orderItemOptions OrderItemOption[]
}

model Customer {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  name      String
  phone     String
  email     String?
  password  String?
  createdAt DateTime @default(now())

  addresses Address[]
  orders    Order[]

  @@unique([storeId, phone])
  @@unique([storeId, email])
}

model Address {
  id           String   @id @default(uuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  label        String?
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zipCode      String
  lat          Float?
  lng          Float?
  isDefault    Boolean  @default(false)

  orders Order[]
}

model Order {
  id         String   @id @default(uuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  addressId  String?
  address    Address? @relation(fields: [addressId], references: [id])

  deliveryType DeliveryType
  status       OrderStatus  @default(RECEIVED)

  subtotal    Decimal @db.Decimal(10, 2)
  deliveryFee Decimal @default(0) @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payment       Payment?
  deliveryTrack DeliveryTracking?
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  notes      String?

  selectedOptions OrderItemOption[]
}

model OrderItemOption {
  id            String     @id @default(uuid())
  orderItemId   String
  orderItem     OrderItem  @relation(fields: [orderItemId], references: [id])
  itemOptionId  String
  itemOption    ItemOption @relation(fields: [itemOptionId], references: [id])
  priceModifier Decimal    @db.Decimal(10, 2)
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id])
  status    OrderStatus
  changedAt DateTime    @default(now())
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id])
  provider          String?
  providerPaymentId String?
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
}

model DeliveryTracking {
  id            String    @id @default(uuid())
  orderId       String    @unique
  order         Order     @relation(fields: [orderId], references: [id])
  trackingToken String    @unique
  lastLat       Float?
  lastLng       Float?
  lastUpdatedAt DateTime?
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime  @default(now())
}
